{
  "name": "erizon-mall",
  "private": true,
  "version": "1.0.0",
  "description": "Erizon Mall (Beruniy) — onlayn do'kon: React frontend + Hono backend, o'rnatilgan SQLite (env'siz ishlaydi)",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"tsx watch --clear-screen=false server/dev.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false server/dev.ts",
    "build": "tsc -b && vite build",
    "preview": "concurrently -k -n web,api -c magenta,cyan \"vite preview\" \"tsx server/dev.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "secrets": "node -e \"const c=require('crypto');console.log('JWT_SECRET='+c.randomBytes(48).toString('base64url'));console.log('DATA_SECRET='+c.randomBytes(48).toString('base64url'));console.log('PASSWORD_PEPPER='+c.randomBytes(24).toString('base64url'))\"",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^1.19.17",
    "@hookform/resolvers": "^3.9.1",
    "dompurify": "^3.2.3",
    "framer-motion": "^11.15.0",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.9",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "sql.js": "^1.14.2",
    "zod": "^3.24.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
