# ============================================================================
# Erizon Mall — server sozlamalari. HAMMASI IXTIYORIY: server env'siz ham ishlaydi.
# Lokal: bu faylni .env.local ga nusxalang. Vercel: Project → Settings → Environment Variables.
# DIQQAT: bu qiymatlar faqat serverda. VITE_ prefiksi qo'ymang va git'ga qo'shmang.
# ============================================================================

# --- Ma'lumotlar bazasi (o'rnatilgan SQLite) ---
# Standart: lokal — data/erizon.sqlite, Vercel — /tmp/erizon.sqlite (vaqtinchalik!)
DATABASE_PATH=

# --- Maxfiy kalitlar ---
# Berilmasa, birinchi ishga tushishda avtomatik yaratilib bazada saqlanadi.
# Berish tavsiya etiladi (baza o'chsa ham sessiyalar va shifrlangan ma'lumotlar saqlanadi).
# Yaratish: npm run secrets
JWT_SECRET=
DATA_SECRET=
PASSWORD_PEPPER=

# Qo'shimcha ruxsat etilgan domenlar (vergul bilan). Saytning o'z domeni avtomatik ruxsat etiladi.
APP_ORIGIN=

# --- Admin ---
# Berilmasa: server/admin.config.ts dagi yagona admin (raqam + parol xeshi) ishlatiladi — hamma joyda bir xil.
ADMIN_PHONE=
ADMIN_PASSWORD=
# Admin uchun 2FA majburiy qilish
ADMIN_REQUIRE_2FA=false

# --- SMS (Eskiz.uz) ---
# Ulanmagan bo'lsa, SMS kod sahifada ko'rsatiladi (namoyish rejimi).
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# SMS ulangan bo'lsa ham kodni ko'rsatish (faqat test uchun)
ALLOW_DEMO_OTP=

# --- Telegram: yangi buyurtma xabarlari ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- To'lov tizimlari (sandbox'da sinab ko'ring) ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=true
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
